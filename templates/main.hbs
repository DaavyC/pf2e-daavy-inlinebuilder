<div class="inlinebuilder-content inlinebuilder-main">
  <div class="inlinebuilder-toggles" aria-label="Inline Builder sections">
    <button type="button" class="inlinebuilder-toggle active" data-section="template" data-tooltip="Area Template">
      <i class="fas fa-bullseye"></i>
      <span>Area Template</span>
    </button>
    <button type="button" class="inlinebuilder-toggle" data-section="damage" data-tooltip="Damage">
      <i class="fas fa-fire"></i>
      <span>Damage</span>
    </button>
    <button type="button" class="inlinebuilder-toggle" data-section="check" data-tooltip="Saving Throw">
      <i class="fas fa-shield-alt"></i>
      <span>Saving Throw</span>
    </button>
    <button type="button" class="inlinebuilder-toggle" data-section="automation" data-tooltip="Automations">
      <i class="fas fa-list-check"></i>
      <span>Automations</span>
    </button>
  </div>

  <fieldset class="template-section" data-section="template">
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Template Type</label>
        <span>Area shape</span>
      </div>
      <div class="inlinebuilder-control icon-btn-group segmented">
        {{#each templateTypes}}
        <button type="button" class="icon-btn template-type-btn" data-value="{{this.value}}" data-tooltip="{{this.tooltip}}">
          <i class="fas {{this.icon}}"></i>
        </button>
        {{/each}}
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Distance</label>
        <span>Range in units</span>
      </div>
      <div class="inlinebuilder-control input-with-controls">
        <input type="number" id="template-distance" name="templateDistance" min="0" step="5" placeholder="ft" value="0">
        <button type="button" id="distance-decrease" class="distance-btn" data-tooltip="Decrease (-5, Shift: -10)">
          <i class="fas fa-minus"></i>
        </button>
        <button type="button" id="distance-increase" class="distance-btn" data-tooltip="Increase (+5, Shift: +10)">
          <i class="fas fa-plus"></i>
        </button>
        <button type="button" id="distance-reset" class="distance-btn" data-tooltip="Reset (0)">
          <i class="fas fa-undo"></i>
        </button>
      </div>
    </div>
  </fieldset>

  <fieldset class="template-section" data-section="damage" style="display:none;">
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Formula</label>
        <span>Damage expression</span>
      </div>
      <div class="inlinebuilder-control input-with-suggest">
        <input type="text" id="damage-formula" name="damageFormula" placeholder="{{defaultDamage}}">
        <button type="button" id="suggest-damage-btn" class="suggest-btn" data-tooltip="Suggest based on level">
          <i class="fas fa-dragon"></i>
        </button>
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Damage Type</label>
        <span>Select a type</span>
      </div>
      <div class="inlinebuilder-control">
        <select id="damage-type" name="damageType">
          <option value="">-- Select --</option>
          {{#each damageTypes}}
          <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Traits</label>
        <span>Characteristics</span>
      </div>
      <div class="inlinebuilder-control icon-btn-group segmented">
        {{#each traits}}
        <button type="button" class="icon-btn trait-btn" data-value="{{this.value}}" data-tooltip="{{this.tooltip}}">
          <i class="fas {{this.icon}}"></i>
        </button>
        {{/each}}
      </div>
    </div>
  </fieldset>

  <fieldset class="template-section" data-section="check" style="display:none;">
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Save</label>
        <span>Check type</span>
      </div>
      <div class="inlinebuilder-control icon-btn-group segmented">
        {{#each saveTypes}}
        <button type="button" class="icon-btn save-type-btn" data-value="{{this.value}}" data-tooltip="{{this.tooltip}}">
          <i class="fas {{this.icon}}"></i>
        </button>
        {{/each}}
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>DC</label>
        <span>Difficulty class</span>
      </div>
      <div class="inlinebuilder-control input-with-suggest">
        <input type="number" id="dc-value" name="dcValue" min="1" max="60" placeholder="{{defaultDC}}">
        <button type="button" id="suggest-dc-btn" class="suggest-btn" data-tooltip="Suggest based on level">
          <i class="fas fa-dragon"></i>
        </button>
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Basic</label>
        <span>Standard save</span>
      </div>
      <div class="inlinebuilder-control inlinebuilder-check-control">
        <input type="checkbox" id="basic-save" name="basicSave" checked>
        <label for="basic-save" class="inlinebuilder-checkbox inlinebuilder-basic-toggle" data-tooltip="Basic save">
          <i class="fas fa-shield-alt"></i>
        </label>
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>Show As</label>
        <span>Chat visibility</span>
      </div>
      <div class="inlinebuilder-control icon-btn-group segmented">
        {{#each showDCOptions}}
        <button type="button" class="icon-btn show-dc-btn{{#if (eq this.value 'all')}} active{{/if}}" data-value="{{this.value}}" data-tooltip="{{this.tooltip}}">
          <i class="fas {{this.icon}}"></i>
        </button>
        {{/each}}
      </div>
    </div>
  </fieldset>

  <fieldset class="template-section" data-section="automation" style="display:none;">
    {{#each automationFields}}
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>{{label}}</label>
      </div>
      <div class="inlinebuilder-control input-with-suggest">
        <input type="text" id="{{inputId}}" name="{{name}}">
        <button type="button" class="add-condition suggest-btn" data-target="#{{inputId}}" title="Add Condition">
          <i class="fas fa-plus"></i>
        </button>
        <button type="button" class="comfort-edit suggest-btn" data-target="#{{inputId}}" title="Text Editor">
          <i class="fas fa-edit"></i>
        </button>
      </div>
    </div>
    {{/each}}
  </fieldset>

  <div class="actions-footer">
    <button type="button" class="insert-all-btn" data-action="insertAll">
      <i class="fas fa-check"></i>
      <span>Apply</span>
    </button>
  </div>
</div>
