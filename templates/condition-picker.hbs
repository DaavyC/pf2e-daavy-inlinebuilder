<div class="inlinebuilder-content">
  <div class="condition-picker-grid">
    {{#each conditions}}
    <div class="cond-btn-card {{actionClass}}{{#if isActive}} active{{/if}}" data-cond="{{slug}}" title="{{actionTitle}}">
      {{#if iconClass}}
      <i class="cond-icon cond-icon-fa {{iconClass}}"></i>
      {{else}}
      <img class="cond-icon" src="{{iconPath}}" alt="{{label}}">
      {{/if}}
      <span class="cond-name">{{label}}</span>
      {{#if isValued}}
      <input type="number" class="cond-value-input" min="1" max="10" value="{{value}}" data-cond="{{slug}}">
      {{/if}}
    </div>
    {{/each}}
  </div>
</div>
