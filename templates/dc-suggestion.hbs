<div class="inlinebuilder-content inlinebuilder-dmg-suggest">
  <fieldset class="template-section">
    {{> inlinebuilderLevelControl}}
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>{{labels.intensity}}</label>
        <span>{{labels.dcCategory}}</span>
      </div>
      <div class="inlinebuilder-control icon-btn-group segmented text-segments">
        {{#each intensities}}
        <button type="button" class="icon-btn dc-btn" data-action="confirmDC" data-intensity="{{value}}">{{label}}</button>
        {{/each}}
      </div>
    </div>
  </fieldset>
</div>
