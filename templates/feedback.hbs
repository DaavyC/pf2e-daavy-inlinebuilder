<div class="form-group stacked">
    <span id="inlinebuilder-feedback-category-label">{{localize "pf2e-daavy-inlinebuilder.Feedback.Category"}}</span>
    <div class="form-fields inlinebuilder-feedback-categories" role="radiogroup" aria-labelledby="inlinebuilder-feedback-category-label">
        <label class="inlinebuilder-feedback-category">
            <input type="radio" name="category" value="Bug" required>
            <span>{{localize "pf2e-daavy-inlinebuilder.Feedback.Categories.Bug"}}</span>
        </label>
        <label class="inlinebuilder-feedback-category">
            <input type="radio" name="category" value="Suggestion" required>
            <span>{{localize "pf2e-daavy-inlinebuilder.Feedback.Categories.Suggestion"}}</span>
        </label>
    </div>
</div>

<div class="form-group stacked">
    <label for="inlinebuilder-feedback-message">{{localize "pf2e-daavy-inlinebuilder.Feedback.Message"}}</label>
    <textarea id="inlinebuilder-feedback-message" name="message" rows="8" maxlength="3000" required></textarea>
    <p class="hint">{{localize "pf2e-daavy-inlinebuilder.Feedback.MessageHint"}}</p>
</div>
