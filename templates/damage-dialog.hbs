<div class="inlinebuilder-content">
  <fieldset class="template-section">
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>{{labels.damage}}</label>
        <span>{{labels.formulaOnly}}</span>
      </div>
      <div class="inlinebuilder-control">
        <input type="text" name="damage" placeholder="1d6">
      </div>
    </div>
    <div class="inlinebuilder-row">
      <div class="inlinebuilder-label">
        <label>{{labels.type}}</label>
        <span>{{labels.damageType}}</span>
      </div>
      <div class="inlinebuilder-control">
        <select name="type-suggest">
          <option value="">{{labels.selectPlaceholder}}</option>
          {{#each damageTypes}}
          <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </fieldset>
  <div class="actions-footer">
    <button type="button" class="insert-all-btn" data-action="add">
      <i class="fas fa-plus"></i>
      <span>{{labels.add}}</span>
    </button>
  </div>
</div>
