<div class="inlinebuilder-content">
  <div class="comfort-edit-container">
    <textarea name="content" rows="10">{{content}}</textarea>
    <button type="button" class="add-condition-comfort" data-action="addCondition" data-tooltip="{{labels.addCondition}}">
      <i class="fas fa-plus"></i>
    </button>
  </div>
  <div class="actions-footer">
    <button type="button" class="insert-all-btn" data-action="save">
      <i class="fas fa-save"></i>
      <span>{{labels.save}}</span>
    </button>
  </div>
</div>
